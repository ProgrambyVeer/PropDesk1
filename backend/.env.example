NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propcrm?schema=public
# Long random strings (openssl rand -hex 32). PC and admin tokens use DIFFERENT secrets.
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-too
PC_SESSION_DAYS=30
ADMIN_SESSION_HOURS=8
# Comma separated list of allowed frontend origins (PC app + Admin app)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public base URL of this API (used to build photo URLs for local storage)
PUBLIC_API_URL=http://localhost:4000
# PC app URL (used in WhatsApp share messages)
PC_APP_URL=http://localhost:5173
# OTP: mock | msg91
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# SMS: mock | msg91
SMS_PROVIDER=mock
# WhatsApp: deeplink | cloud_api (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=deeplink
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email: mock | smtp
EMAIL_PROVIDER=mock
SMTP_URL=
# Push: mock | webpush
PUSH_PROVIDER=mock
# Storage: local | s3 (any S3-compatible: AWS S3, Cloudflare R2, MinIO, DO Spaces)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# First SUPER_ADMIN created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SCHEDULER_INTERVAL_SECONDS=30
